# Model weights ship as a release artifact, never in git history.
src/email_triage/resources/model/*.onnx
src/email_triage/resources/model/tokenizer.json

# PHI-bearing local data. Never commit.
data/
out/
*.jsonl
!tests/fixtures/**/*.jsonl
# Real inbound email samples: patient names, DOBs, claim numbers, TINs.
# This repo is PUBLIC - these must never be staged. Ground truth derived from
# them lives in SAMPLE_RULES.md with every identifier re-keyed.
samples.xlsx
*.xlsx
~$*

